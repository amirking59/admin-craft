# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build
/dist
/.output
/.tanstack
/.nitro

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files; .env.example is committed
.env*
!.env.example

# Paraglide output, regenerated by the Vite plugin and on install
/src/paraglide
/project.inlang/cache

# vercel
.vercel

# typescript
*.tsbuildinfo
