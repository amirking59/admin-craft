{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "proseWrap": "never",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs:": false,
  "semi": true,
  "quoteProps": "consistent",
  "sortPackageJson": false,
  "ignorePatterns": [
    "/dist",
    "/coverage",
    "/.nx/cache",
    "/.nx/workspace-data"
  ]
}
